---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Donate" description="Support the free Genesis Coupe LS swap guides. Donations cover the domain and hosting so the guides stay free for everyone.">
  <h1>Support the Site</h1>
  <p>
    All the build guides are free and will stay free. If this resource helped you avoid a costly mistake
    or just saved you hours of searching, a small donation is appreciated.
  </p>
  <p>
    Money goes toward the domain, hosting, and keeping the site online.
  </p>

  <div style="margin: 1.5rem 0;">
    <a
      href="https://buymeacoffee.com/alexknight"
      class="stripe-btn orange"
      target="_blank"
      rel="noopener"
    >
      Donate on Buy Me a Coffee
    </a>
  </div>
  <p class="stripe-note">
    Choose any amount, one-time or monthly. Checkout is handled securely by Buy Me a Coffee.
  </p>
</BaseLayout>
