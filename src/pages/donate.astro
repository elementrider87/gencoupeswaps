---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Donate" description="Support the free LS Gen Coupe swap guides.">
  <h1>Support the Site</h1>
  <p>
    All the build guides are free and will stay free. If this resource helped you avoid a costly mistake
    or just saved you hours of searching, a small donation is appreciated.
  </p>
  <p>
    Money goes toward the domain, any future paid services (like the featured-build Stripe fees), and
    keeping the site online.
  </p>

  <!-- 
    STRIPE SETUP:
    1. In Stripe Dashboard create a Product (or use Payment Links with custom amounts)
    2. Easiest: create three Payment Links for $5, $10, $25 (or one “Customer chooses amount” link)
    3. Replace the hrefs below with your real Stripe Payment Link URLs
  -->
  <div style="margin: 1.5rem 0;">
    <a
      href="https://buy.stripe.com/test_REPLACE_WITH_YOUR_5_DONATION_LINK"
      class="stripe-btn orange"
      target="_blank"
      rel="noopener"
    >
      Donate $5
    </a>
    <a
      href="https://buy.stripe.com/test_REPLACE_WITH_YOUR_10_DONATION_LINK"
      class="stripe-btn orange"
      target="_blank"
      rel="noopener"
    >
      Donate $10
    </a>
    <a
      href="https://buy.stripe.com/test_REPLACE_WITH_YOUR_25_DONATION_LINK"
      class="stripe-btn orange"
      target="_blank"
      rel="noopener"
    >
      Donate $25
    </a>
  </div>
  <p class="stripe-note">
    Secure checkout powered by Stripe. Replace the button links with your real Payment Links when ready.
  </p>
</BaseLayout>
