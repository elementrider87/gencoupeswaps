---
import BaseLayout from '../layouts/BaseLayout.astro';
import entriesRaw from '../data/hp-wars.json';

type Entry = {
  name: string; car: string; engine: string;
  induction: 'na' | 'turbo' | 'supercharged' | 'nitrous';
  adder?: string; boost?: string; fuel?: string; trans?: string;
  whp: number; wtq?: number; wtqApprox?: boolean; dyno?: string; date?: string;
  proof?: string; build?: string; note?: string;
};
// Always ranked highest to lowest whp, so new entries drop into place automatically.
const entries = (entriesRaw as Entry[]).slice().sort((a, b) => b.whp - a.whp);
const labels: Record<string, string> = { na: 'N/A', turbo: 'Turbo', supercharged: 'Supercharged', nitrous: 'Nitrous' };
const fmt = (n: number) => Math.floor(n).toString();
const top = entries[0];
---

<BaseLayout title="HP Wars" description="Dyno leaderboard for swapped Hyundai Genesis Coupes (LS, JZ and more), ranked by wheel horsepower with dyno sheets.">
  <h1>HP Wars</h1>
  <p>The dyno leaderboard for swapped Genesis Coupes (LS, JZ, and anything else), ranked by wheel horsepower. Tap a name to see the dyno sheet.</p>

  {entries.length === 0 ? (
    <div class="hp-empty">
      <p class="hp-empty-big">No entries yet. Be the first on the board.</p>
    </div>
  ) : (
    <ol class="hp-list">
      {entries.map((e, i) => (
        <li class="hp-row">
          <span class="hp-rank">{i + 1}</span>
          <div class="hp-main">
            <div class="hp-top">
              {e.proof ? (
                <a class="hp-name lb-link" href={e.proof} data-full={e.proof} data-caption={`${e.name}: ${fmt(e.whp)} hp${e.wtq ? ' / ' + (e.wtqApprox ? '~' : '') + fmt(e.wtq) + ' tq' : ''}${e.dyno ? ' (' + e.dyno + (e.date ? ', ' + e.date : '') + ')' : ''}`}>{e.name}</a>
              ) : <span class="hp-name">{e.name}</span>}
              <span class="hp-power"><strong>{fmt(e.whp)}</strong> hp{e.wtq && <> / <strong>{e.wtqApprox ? '~' : ''}{fmt(e.wtq)}</strong> tq</>}</span>
            </div>
            <div class="hp-stats">
              {[e.car, e.engine, labels[e.induction] + (e.adder ? ` (${e.adder})` : ''), e.boost, e.fuel, e.trans, e.dyno, e.date].filter(Boolean).join(' · ')}
              {e.build && <> · <a href={e.build}>Build</a></>}
            </div>
            {e.note && <div class="hp-note">{e.note}</div>}
          </div>
        </li>
      ))}
    </ol>
  )}

  <h2>Get on the Board</h2>
  <p>Email <a href="mailto:Elementrider87@gmail.com?subject=HP%20Wars%20submission">Elementrider87@gmail.com</a> with:</p>
  <ul>
    <li>Your name and Instagram / Facebook / YouTube handle</li>
    <li>Car (year, BK1 or BK2), engine, power adder and boost, transmission, and fuel/octane</li>
    <li>A clear photo of the <strong>dyno sheet</strong>, plus a dyno video if you have one</li>
    <li>Dyno type (Dynojet, Mustang, Dynapack, hub dyno…) and date</li>
    <li>One good photo of the car</li>
  </ul>

  <h2>Rules</h2>
  <ul>
    <li>Wheel horsepower only (no crank estimates).</li>
    <li>Your best pull, with the dyno sheet visible. A video is preferred.</li>
    <li>Everyone is ranked together, highest to lowest. Your power adder, boost, and fuel are listed with your entry.</li>
    <li>Dyno brands read differently (a Mustang dyno usually reads lower than a Dynojet), so dyno type is listed on every entry.</li>
    <li>Re-submit any time you make more power and your entry gets updated.</li>
  </ul>

  {top && <p class="updated">Current leader: {top.name}, {fmt(top.whp)} hp.</p>}
</BaseLayout>


<style>
  .hp-empty { background: var(--bg-card); border: 1px dashed var(--border); border-radius: var(--radius); padding: 1.5rem; text-align: center; }
  .hp-empty-big { font-size: 1.2rem; font-weight: 600; }
  .hp-list { list-style: none; margin: 1rem 0 0 !important; padding: 0; display: grid; gap: 0.6rem; }
  .hp-row { display: grid; grid-template-columns: 2.4rem 1fr; gap: 0.75rem; align-items: start; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 0.8rem 1rem; margin: 0 !important; }
  .hp-rank { font-weight: 800; font-size: 1.4rem; color: var(--accent); line-height: 1.2; }
  .hp-top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.25rem 1rem; align-items: baseline; }
  .hp-name { font-weight: 700; font-size: 1.05rem; }
  .hp-power { font-size: 1.05rem; white-space: nowrap; }
  .hp-power strong { font-size: 1.3rem; }
  .hp-stats { color: var(--text-muted); font-size: 0.88rem; margin-top: 0.2rem; }
  .hp-note { font-size: 0.85rem; margin-top: 0.35rem; color: var(--text-muted); font-style: italic; }
</style>
