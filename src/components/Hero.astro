---
interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "LS Swap Genesis Coupe Guides",
  subtitle
} = Astro.props;
---

<section class="hero" style="background-image: url('/images/hero.jpg'); background-image: image-set(url('/images/web/hero-1280.webp') type('image/webp'), url('/images/hero.jpg') type('image/jpeg')); background-size: cover; background-position: center;">
  <div class="hero-overlay">
    <h1>{title}</h1>
    {subtitle && <p>{subtitle}</p>}
  </div>
</section>
