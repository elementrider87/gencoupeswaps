---
import SiteLinks from './SiteLinks.astro';
import GuidesNav from './GuidesNav.astro';
import FeaturedNav from './FeaturedNav.astro';
---

<aside class="sidebar" id="sidebar" aria-label="Site and featured build navigation">
  <!-- Phone menu: featured categories sit under the Featured Builds link, then the Build Guides list, like every other page -->
  <SiteLinks featuredNav={true} />
  <div class="featured-mobile-only"><GuidesNav /></div>
  <!-- Desktop: the site links are in the top bar, so Featured Builds gets its own section here -->
  <div class="featured-desktop-only">
    <div class="sidebar-label sidebar-section-title">Featured Builds</div>
    <FeaturedNav />
  </div>
</aside>
