---
import SiteLinks from './SiteLinks.astro';
import builds from '../data/featured-builds.json';
const currentPath = Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/\/$/, '');
const all = builds as { slug: string; title: string; category: string }[];
const categories = [
  { href: '/featured#supercharged', label: 'Supercharged' },
  { href: '/featured#turbo', label: 'Turbo' },
  { href: '/featured#na', label: 'N/A (Naturally Aspirated)' },
  { href: '/featured#oem', label: 'OEM Builds' },
];
---

<aside class="sidebar" id="sidebar" aria-label="Site and featured build navigation">
  <SiteLinks />
  <div class="sidebar-label">Featured Builds</div>
  {categories.map(c => {
    const id = c.href.split('#')[1];
    const list = all.filter((b) => b.category === id);
    return (
      <>
        <a href={c.href}>{c.label}</a>
        {list.length > 0 && (
          <div class="sidebar-sub">
            {list.map((b) => <a href={`/featured/${b.slug}`} class={currentPath === `/featured/${b.slug}` ? 'active' : ''}>{b.title}</a>)}
          </div>
        )}
      </>
    );
  })}
  <a href="/featured#submit">Submit Your Build</a>
</aside>
