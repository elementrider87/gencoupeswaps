---
const currentPath = Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: 'Home' },
  { href: '/featured', label: 'Featured Builds' },
  { href: '/hp-wars', label: 'HP Wars' },
  { href: '/time-slips', label: 'Time Slips' },
  { href: '/resources', label: 'Resources' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
  { href: '/discounts', label: 'Discounts' },
  { href: '/donate', label: 'Donate' },
];
---

<div class="sidebar-site">
  <div class="sidebar-label sidebar-section-title">Site</div>
  {links.map((l) => (
    <a href={l.href} class={[(l.href === '/' ? currentPath === '/' : currentPath.startsWith(l.href)) ? 'active' : '', l.href === '/donate' ? 'sidebar-donate' : '', l.href === '/featured' ? 'sidebar-featured' : ''].filter(Boolean).join(' ')}>
      {l.href === '/donate' ? <span class="donate-shine">{l.label}</span> : l.href === '/featured' ? <span class="flame-text">{l.label}</span> : l.label}
    </a>
  ))}
</div>
