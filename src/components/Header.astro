---
const currentPath = Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/\/$/, '') || '/';
---

<header class="site-header">
  <a href="/" class="logo">Gen<span>Coupe</span>Swaps</a>

  <!-- Search -->
  <div class="search-wrap" id="search-wrap">
    <input
      type="search"
      id="site-search"
      class="search-input"
      placeholder="Search guides…"
      autocomplete="off"
      aria-label="Search guides"
    />
    <ul class="search-results" id="search-results" hidden></ul>
  </div>

  <button class="menu-toggle" id="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="sidebar">☰</button>

  <nav class="top-nav" id="top-nav">
    <a href="/" class={currentPath === '/' ? 'active' : ''}>Home</a>
    <a href="/featured" class={currentPath.startsWith('/featured') ? 'active' : ''}>Featured Builds</a>
    <a href="/hp-wars" class={currentPath.startsWith('/hp-wars') ? 'active' : ''}>HP Wars</a>
    <a href="/resources" class={currentPath.startsWith('/resources') ? 'active' : ''}>Resources</a>
    <a href="/about" class={currentPath.startsWith('/about') ? 'active' : ''}>About</a>
    <a href="/contact" class={currentPath.startsWith('/contact') ? 'active' : ''}>Contact</a>
    <a href="/discounts" class={currentPath.startsWith('/discounts') ? 'active' : ''}>Discounts</a>
    <a href="/donate" class="donate-btn">Donate</a>
  </nav>
</header>

<script>
  // ---- Mobile menu: the ☰ button opens the sidebar drawer (site links + all guides) ----
  const toggle = document.getElementById('menu-toggle');
  const sidebar = document.getElementById('sidebar');
  const backdrop = document.createElement('div');
  backdrop.className = 'drawer-backdrop';
  document.body.appendChild(backdrop);

  function setMenu(open: boolean) {
    sidebar?.classList.toggle('open', open);
    document.body.classList.toggle('menu-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    if (toggle) toggle.textContent = open ? '✕' : '☰';
  }

  toggle?.addEventListener('click', () => setMenu(!sidebar?.classList.contains('open')));
  backdrop.addEventListener('click', () => setMenu(false));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });
  document.querySelectorAll('.sidebar a').forEach(link => link.addEventListener('click', () => setMenu(false)));

  // ---- Site search (client-side, no backend) ----
  const pages = [
    { label: 'Home', href: '/', keywords: 'home start main' },
    { label: 'Featured Builds', href: '/featured', keywords: 'featured builds showcase submit' },
    { label: 'HP Wars', href: '/hp-wars', keywords: 'hp wars horsepower dyno leaderboard whp power numbers rankings' },
    { label: 'Resources', href: '/resources', keywords: 'resources links parts kits forums' },
    { label: 'About', href: '/about', keywords: 'about story why' },
    { label: 'Contact', href: '/contact', keywords: 'contact email contribute submit' },
    { label: 'Discounts', href: '/discounts', keywords: 'discounts discount codes coupons deals promo vendor holley tune tuning turbo joe' },
    { label: 'Donate', href: '/donate', keywords: 'donate support tip' },
    { label: 'Engine Selection', href: '/guides/engine-selection', keywords: 'engine selection ls ls1 ls2 ls3 ls7 lq4 lq9 5.3 6.0 6.2 donor' },
    { label: 'Motor Mounts (Swap Kits)', href: '/guides/swap-kits#motor-mounts', keywords: 'motor mounts engine mounts kit loj sikky isr cx racing poly urethane' },
    { label: 'Oil Pan (Swap Kits)', href: '/guides/swap-kits#oil-pan', keywords: 'oil pan rear sump front sump cx racing sikky loj pickup' },
    { label: 'Headers (Swap Kits)', href: '/guides/swap-kits#headers', keywords: 'headers exhaust manifold sikky isr cx racing y pipe' },
    { label: 'Trans Mount (Swap Kits)', href: '/guides/swap-kits#trans-mount', keywords: 'transmission mount trans mount t56 crossmember cx racing' },
    { label: 'Ford 8.8 Swap (Differential)', href: '/guides/differential#ford-88', keywords: 'ford 8.8 irs dss axles 1000hp rear end swap' },
    { label: 'Swap Kits', href: '/guides/swap-kits', keywords: 'swap kits sikky loj isr mounts oil pan headers' },
    { label: 'Alternator', href: '/guides/alternator', keywords: 'alternator charging bracket high output' },
    { label: 'Power Steering', href: '/guides/power-steering', keywords: 'power steering pump rack lines reservoir' },
    { label: 'Wiring', href: '/guides/wiring', keywords: 'wiring harness fuse box starter push to start reverse lights brake switch can bus' },
    { label: 'ECUs & Tuning', href: '/guides/ecu', keywords: 'ecu holley terminator dash speedo vss j4 tuning' },
    { label: 'Cooling System', href: '/guides/cooling', keywords: 'cooling radiator fans relays iat heater hose oil cooler spal' },
    { label: 'Exhaust', href: '/guides/exhaust', keywords: 'exhaust headers heat shielding dei wrap' },
    { label: 'Transmission', href: '/guides/transmission', keywords: 'transmission t56 magnum clutch master wilwood pilot bushing alignment tool 4l80' },
    { label: 'Driveshaft', href: '/guides/driveshaft', keywords: 'driveshaft collins adapter spicer yoke pst' },
    { label: 'Differential & Axles', href: '/guides/differential', keywords: 'differential axles sedan ford 8.8 irs dss cv' },
    { label: 'Fuel System', href: '/guides/fuel-system', keywords: 'fuel pump relay evap solenoid regulator lines return' },
    { label: 'Intake & Air', href: '/guides/intake', keywords: 'intake manifold throttle body air filter maf' },
    { label: 'Accessories', href: '/guides/accessories', keywords: 'accessories ac a/c brackets belt drive' },
    { label: 'A/C System', href: '/guides/ac', keywords: 'ac a/c air conditioning compressor vintage air binary switch hoses' },
    { label: 'Gas Pedal', href: '/guides/gas-pedal', keywords: 'gas pedal throttle dbw drive by wire cable accelerator 10379038' },
    { label: 'Brakes & ABS Delete', href: '/guides/brakes', keywords: 'brakes abs delete proportioning valve line lock brembo master cylinder odometer' },
    { label: 'Troubleshooting', href: '/guides/troubleshooting', keywords: 'troubleshooting no start overheating gauges problems' },
  ];

  const input = document.getElementById('site-search') as HTMLInputElement | null;
  const resultsEl = document.getElementById('search-results');

  function renderResults(matches: typeof pages) {
    if (!resultsEl) return;
    if (matches.length === 0) {
      resultsEl.innerHTML = '<li class="search-empty">No matches</li>';
      resultsEl.hidden = false;
      return;
    }
    resultsEl.innerHTML = matches
      .map(m => `<li><a href="${m.href}">${m.label}</a></li>`)
      .join('');
    resultsEl.hidden = false;
  }

  function doSearch(q: string) {
    const term = q.trim().toLowerCase();
    if (!term) {
      if (resultsEl) resultsEl.hidden = true;
      return;
    }
    const matches = pages.filter(p =>
      p.label.toLowerCase().includes(term) ||
      p.keywords.toLowerCase().includes(term)
    );
    renderResults(matches.slice(0, 8));
  }

  input?.addEventListener('input', () => doSearch(input.value));
  input?.addEventListener('focus', () => {
    if (input.value.trim()) doSearch(input.value);
  });

  document.addEventListener('click', (e) => {
    const wrap = document.getElementById('search-wrap');
    if (wrap && !wrap.contains(e.target as Node) && resultsEl) {
      resultsEl.hidden = true;
    }
  });

  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      const first = resultsEl?.querySelector('a') as HTMLAnchorElement | null;
      if (first) {
        window.location.href = first.href;
      }
    }
    if (e.key === 'Escape') {
      if (resultsEl) resultsEl.hidden = true;
      input.blur();
    }
  });
</script>
