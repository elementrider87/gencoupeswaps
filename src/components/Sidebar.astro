---
import SiteLinks from './SiteLinks.astro';
const currentPath = Astro.url.pathname;

const guides = [
  { href: '/guides/engine-selection', label: 'Engine Selection' },
  { href: '/guides/motor-mounts', label: 'Motor Mounts' },
  { href: '/guides/swap-kits', label: 'Swap Kits' },
  { href: '/guides/alternator', label: 'Alternator' },
  { href: '/guides/power-steering', label: 'Power Steering' },
  { href: '/guides/wiring', label: 'Wiring' },
  { href: '/guides/ecu', label: 'ECUs & Tuning' },
  { href: '/guides/cooling', label: 'Cooling System' },
  { href: '/guides/exhaust', label: 'Exhaust & Heat Shielding' },
  { href: '/guides/transmission', label: 'Transmission & Clutch' },
  { href: '/guides/driveshaft', label: 'Driveshaft' },
  { href: '/guides/differential', label: 'Differential & Axles' },
  { href: '/guides/brakes', label: 'Brakes & ABS Delete' },
  { href: '/guides/fuel-system', label: 'Fuel System' },
  { href: '/guides/intake', label: 'Intake & Air' },
  { href: '/guides/accessories', label: 'Accessories' },
  { href: '/guides/ac', label: 'A/C System' },
  { href: '/guides/gas-pedal', label: 'Gas Pedal' },
  { href: '/guides/troubleshooting', label: 'Troubleshooting' },
];
---

<aside class="sidebar" id="sidebar" aria-label="Site and guide navigation">
  <SiteLinks />
  <div class="sidebar-label">Build Guides</div>
  {guides.map(g => (
    <a href={g.href} class={currentPath.replace(/\/$/, '') === g.href ? 'active' : ''}>
      {g.label}
    </a>
  ))}
</aside>
